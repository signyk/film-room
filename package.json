{
  "name": "fantabolti",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "uv run python -m ff.build_data",
    "data:offline": "uv run python -m ff.build_data --offline",
    "dev": "vite",
    "build": "tsc -p web && tsc -p worker && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy --config dist/fantabolti/wrangler.json",
    "season": "tsx scripts/fetch-season.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
